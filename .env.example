# ── EXFO auth (correct from your capture) ──────────────────────────────────
EXFO_AUTH_BASE=https://raman.ems.exfo-fms.com
EXFO_TOKEN_PATH=/auth/realms/Fiber/protocol/openid-connect/token
EXFO_CLIENT_ID=fg-topologyui
# EXFO_CLIENT_SECRET=      # only if you switch to fg-topologyapi
# EXFO_SCOPE=

# ── Relay access ───────────────────────────────────────────────────────────
APP_KEY=choose-a-long-random-string
APP_ORIGIN=*                # lock to your app URL in production

# ── Resolver (GraphQL) — confirmed from capture ────────────────────────────
TOPO_HOST=https://raman.ems.exfo-fms.com
GRAPHQL_URL=https://raman.ems.exfo-fms.com/topology/graphql/graphql
PAGE_SIZE=50

# ── Tone call — confirmed shape from capture ───────────────────────────────
LIVE_TONE=0                 # 0 = simulate (safe). Set 1 to actually tone EXFO.
TONE_PATH=/api/topology/control/opticalroutes/{route_id}/testsetup/build
TONE_METHOD=POST
TONE_ID_FIELD=id            # {route_id} from GraphQL node 'id' (UUID). If build 404s, try: rtuId
MEAS_PAYLOAD_TEMPLATE={"MeasurementType":"PonXplorer;TimedSource;Modulation={freq};Duration={duration}","WavelengthsUsed":[{wl_m}]}
SETUP_NAME=

# ── Continuity (v12) ──────────────────────────────────────────────────────
CONTINUITY_EXCLUDE=         # e.g. R35-36 or full route names; never toned or tested

# ── Run logs (v20) ────────────────────────────────────────────────────────
# Every finished E2E run, and the tester's feedback on it, is saved as JSON to this private repo.
LOG_REPO=Motion-Rail/relay-logs
LOG_TOKEN=                  # fine grained GitHub token: this repo only, Contents read and write. Set in Render, never in git.

# ── Run-end notice (v21) ─────────────────────────────────────────────────
TEAMS_WEBHOOK=              # Teams Workflows webhook URL for the channel. Set in Render, never in git.
APP_URL=https://motionrail.onrender.com
